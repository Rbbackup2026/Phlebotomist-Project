    success: true,
    items: [
      { sku: "EDTA-PURPLE", name: "EDTA Violet Tube", quantity: 24, threshold: 10 },
      { sku: "SST-GOLD", name: "Serum Separator Tube", quantity: 18, threshold: 10 },
      { sku: "FLUORIDE", name: "Fluoride Tube", quantity: 8, threshold: 10 },
      { sku: "URINE-CUP", name: "Urine Container", quantity: 15, threshold: 5 },
    ],
  });
});

router.post("/phlebo/inventory/request", verifyPhlebo, async (req, res) => {
  const { sku, quantity, note } = req.body;
  console.log("[Inventory Request]", {
    phlebo: req.phlebo._id,
    sku,
    quantity,
    note,
  });
  res.json({ success: true, message: "Replenishment request sent to Ops" });
});

module.exports = router;
