# Phlebo platform — OWN MongoDB (alag from Wello)
MONGO_URI=mongodb://localhost:27017/phlebo
PORT=3010
NODE_ENV=development
JWT_SECRET=phlebo-change-this-secret

# Seeded Wello client (must match Wello Backend .env)
WELLO_CLIENT_SLUG=wello
WELLO_CLIENT_NAME=Wello
WELLO_API_KEY=pk_live_wello_dev_change_me
WELLO_WEBHOOK_SECRET=whsec_wello_dev_change_me
WELLO_WEBHOOK_URL=http://localhost:3000/v1/api/phlebo/webhook
WELLO_CATALOG_API_BASE=http://localhost:3000/v1/api

# Ops login (PhleboApp Ops tab)
OPS_EMAIL=ops@phlebo.local
OPS_PASSWORD=ops123456

PLATFORM_SEED_KEY=phlebo-seed-dev

# Optional — job address geocoding (route optimization / geofencing). Uses free
# OpenStreetMap Nominatim, no API key needed, but it does require a real identifying
# User-Agent or requests get blocked. Safe to leave default for dev.
GEOCODE_USER_AGENT=WelloPhleboBackend/1.0 (contact: ops@wello.local)
