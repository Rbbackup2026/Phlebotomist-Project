# Phlebo platform — OWN MongoDB (alag from Wello)
MONGO_URI=mongodb://localhost:27017/phlebo
PORT=3010
NODE_ENV=development

# REQUIRED in production — long random string (never commit real prod secret)
JWT_SECRET=phlebo-change-this-secret

# Comma-separated browser origins for admin/partners (empty = open in dev; locked in prod)
# CORS_ORIGINS=https://admin.yourdomain.com,https://partner.example.com

# Public base URL for absolute media links in APIs
# PUBLIC_BASE_URL=https://api.yourdomain.com

# Seeded Wello client (must match Wello Backend .env)
WELLO_CLIENT_SLUG=wello
WELLO_CLIENT_NAME=Wello
WELLO_API_KEY=pk_live_wello_dev_change_me
WELLO_WEBHOOK_SECRET=whsec_wello_dev_change_me
WELLO_WEBHOOK_URL=http://localhost:3000/v1/api/phlebo/webhook
WELLO_CATALOG_API_BASE=http://localhost:3000/v1/api

# LIS test catalog (rate-list) — full endpoint URL (replaces Wello catalog when set)
# LIS_CATALOG_API_URL=https://lis.example.com/api/GetItemRate
# LIS_CATALOG_API_TOKEN=
# CATALOG_PROVIDER=lis
# Home-collection bill — sample + payment ke baad BookingAPINew
# LIS_BOOKING_API_URL=https://lis6.mdrcindia.com/mdrcnew/api/BookingAPI/BookingAPINew
# LIS_BOOKING_ENABLED=true

# Superadmin email/password env mein set NAHI karte.
# Pehli baar: POST /v1/api/register-superadmin (header x-seed-key = PLATFORM_SEED_KEY)
# Phir superadmin /register-admin aur /register-lab se baaki accounts banata hai.
# (Legacy only) SEED_OPS_USER=true + OPS_EMAIL/OPS_PASSWORD = boot pe auto-create

# Gate for first-time setup + partner client register (REQUIRED strong value in production)
PLATFORM_SEED_KEY=phlebo-seed-dev
# Production: set ALLOW_CLIENT_REGISTER=true only when intentionally onboarding a partner
# ALLOW_CLIENT_REGISTER=false

# OTP 123456. TextGuru password+sender+template set hon to demo auto-off.
# Live pe ALLOW_DEMO_OTP=false  (staff ko asli SMS; sabke liye 123456 mat kholo)
ALLOW_DEMO_OTP=false

# Google Play reviewers ko Indian SMS nahi milti. Sirf ye 10-digit numbers:
# SMS skip + PLAY_REVIEWER_OTP (default 123456). Admin me ye numbers pehle add karo.
# PLAY_REVIEWER_PHONES=9876543210,9123456780
# PLAY_REVIEWER_OTP=123456

# TextGuru Send SMS API v22.0 (Developer → API & Docs)
# TEXTGURU_API_URL=https://www.textguru.in/api/v22.0/
# TEXTGURU_USERNAME=mdrcindia.com
# TEXTGURU_PASSWORD=
# TEXTGURU_SENDER=XXXXXX
# TEXTGURU_DLT_TEMPLATE_ID=1507166522004532781
# Message DLT template se EXACT match. {otp} = 6-digit code.
# TEXTGURU_OTP_MESSAGE=Dear {name}, Welcome to MDRC Phlebo! {otp} is your One Time Password (OTP) for login into your account. www.mdrcindia.com.
# Official dmobile: 91 + 10 digits. 10-digit only: TEXTGURU_NUMBERS_FORMAT=10
# TEXTGURU_API_METHOD=POST
# TEXTGURU_SERVICE_TYPE=OTP
# TEXTGURU_FALLBACK_URL=https://www.textguru.in/imobile/api.php
# TEXTGURU_PE_ID=
# TEXTGURU_PATIENT_OTP_MESSAGE=Your sample collection OTP is {otp}. Share it with the phlebotomist only.
# TEXTGURU_PATIENT_DLT_TEMPLATE_ID=

# Optional — job address geocoding / live map. Same keys as AmbulanceBackend.
# Browser Live Map: HTTP referrers must include http://localhost:3010/*
# Enable: Maps JavaScript API (+ Places / Geocoding for address typeahead). Billing ON.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# Optional — Nominatim fallback User-Agent if Google key is missing/rejected
GEOCODE_USER_AGENT=WelloPhleboBackend/1.0 (contact: ops@wello.local)

# Razorpay UPI QR at sample collection (Test keys first: rzp_test_...)
# Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Account & Settings → Webhooks  URL: https://YOUR_API/v1/api/webhooks/razorpay
# Events: qr_code.credited, payment.captured, payment_link.paid
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MERCHANT_NAME=MODERN DIAGNOSTIC AND RESEARCH CENTRE LIMITED
